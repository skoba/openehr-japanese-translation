# Dependencies of openehr-ruby (the parser used by tools/adl_i18n.rb).
# `bundle install` then `tools/setup_openehr.sh` (clones + patches the parser),
# or simply `gem install openehr` when the released gem parses your archetypes.
source 'https://rubygems.org'
gem 'treetop'
gem 'polyglot'
gem 'locale'
gem 'i18n'
gem 'activesupport'
gem 'builder'
gem 'nokogiri'
gem 'xml-simple'

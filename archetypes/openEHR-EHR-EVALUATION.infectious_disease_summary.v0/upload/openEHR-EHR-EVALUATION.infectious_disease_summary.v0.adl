	openEHR-EHR-EVALUATION.infectious_disease_summary.v0

concept
	[at0000]	-- Infectious disease summary
language
	original_language = <[ISO_639-1::en]>
	translations = <
		["ja"] = <
			language = <[ISO_639-1::ja]>
			author = <
